{
  "name": "bb-plugin-better-sidebar",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "bb": ">=0.39",
    "bbPluginSdk": ">=0.4.8"
  },
  "bb": {
    "name": "Better Sidebar",
    "description": "Groups sidebar threads by project, gives each project an icon (from its repository, a URL, or your own file), and uses it as the browser tab favicon.",
    "branding": {
      "icon": "PanelLeft"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.8",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.10.0",
    "hono": "^4.11.9",
    "jsdom": "^27.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "description": "A richer BB sidebar: threads grouped by project, per-project icons resolved from GitHub or git, and the project's icon in your browser tab.",
  "license": "MIT",
  "keywords": [
    "bb",
    "bb-plugin",
    "sidebar",
    "favicon",
    "projects"
  ],
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
